{
  "poll_interval_seconds": 0.5,
  "log_rewrites": true,
  "rules": [
    {
      "name": "X / Twitter to FxTwitter",
      "enabled": true,
      "hosts": ["twitter.com", "www.twitter.com", "mobile.twitter.com"],
      "target_host": "fxtwitter.com"
    },
    {
      "name": "X to FxTwitter",
      "enabled": true,
      "hosts": ["x.com", "www.x.com"],
      "target_host": "fxtwitter.com"
    },
    {
      "name": "pixiv to phixiv",
      "enabled": true,
      "hosts": ["pixiv.net", "www.pixiv.net"],
      "target_host": "phixiv.net"
    },
    {
      "name": "Instagram to ddinstagram",
      "enabled": true,
      "hosts": ["instagram.com", "www.instagram.com"],
      "target_host": "ddinstagram.com"
    },
    {
      "name": "TikTok to tnktok",
      "enabled": true,
      "hosts": ["tiktok.com", "www.tiktok.com", "m.tiktok.com", "vm.tiktok.com", "vt.tiktok.com"],
      "target_host": "tnktok.com"
    },
    {
      "name": "Reddit to rxddit",
      "enabled": true,
      "hosts": ["reddit.com", "www.reddit.com", "old.reddit.com", "new.reddit.com"],
      "target_host": "rxddit.com"
    },
    {
      "name": "Tumblr to tpmblr",
      "enabled": true,
      "hosts": ["tumblr.com", "www.tumblr.com"],
      "target_host": "tpmblr.com"
    },
    {
      "name": "Tumblr blog subdomains to tpmblr",
      "enabled": true,
      "host_suffix": ".tumblr.com",
      "target_suffix": ".tpmblr.com"
    },
    {
      "name": "Bluesky to FxBluesky",
      "enabled": true,
      "hosts": ["bsky.app", "www.bsky.app"],
      "target_host": "fxbsky.app"
    },
    {
      "name": "TikTok to tfxktok",
      "enabled": false,
      "hosts": ["tiktok.com", "www.tiktok.com", "m.tiktok.com", "vm.tiktok.com", "vt.tiktok.com"],
      "target_host": "tfxktok.com"
    },
    {
      "name": "TikTok to TikTokEZ",
      "enabled": false,
      "hosts": ["tiktok.com", "www.tiktok.com", "m.tiktok.com", "vm.tiktok.com", "vt.tiktok.com"],
      "target_host": "tiktokez.com"
    },
    {
      "name": "Reddit to rxyddit",
      "enabled": false,
      "hosts": ["reddit.com", "www.reddit.com", "old.reddit.com", "new.reddit.com"],
      "target_host": "rxyddit.com"
    },
    {
      "name": "Instagram to InstagramEZ",
      "enabled": false,
      "hosts": ["instagram.com", "www.instagram.com"],
      "target_host": "instagramez.com"
    },
    {
      "name": "Threads to fixthreads",
      "enabled": false,
      "hosts": ["threads.net", "www.threads.net"],
      "target_host": "fixthreads.net"
    },
    {
      "name": "Twitch to FxTwitch",
      "enabled": false,
      "hosts": ["twitch.tv", "www.twitch.tv", "m.twitch.tv"],
      "target_host": "fxtwitch.tv"
    }
  ]
}
